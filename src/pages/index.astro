---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';

const base = `https://${site.domain}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    applicationCategory: site.category,
    operatingSystem: 'Any',
    image: `${base}/og.png`,
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-5 sm:pt-12">
    <p class="mb-3 hidden sm:inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-brand-ink">{site.tagline}</p>
    <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.08] tracking-tight [text-wrap:balance] sm:text-5xl">
      Knitting and crochet increase calculator: increase evenly across a row
    </h1>
    <p class="mt-3 hidden max-w-2xl text-base text-muted sm:block sm:text-lg">{site.description}</p>
    <div class="mt-6 min-h-[44rem] lg:min-h-[32rem]"><Tool /></div>
    <AdSlot />
  </section>
  <Article />
  <Faq />
</Base>
