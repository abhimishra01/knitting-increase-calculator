---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';
import { cases } from '../data/cases.ts';
import { href } from '../lib/url.ts';

const base = `https://${site.domain}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    applicationCategory: site.category,
    operatingSystem: 'Any',
    image: `${base}/og.png`,
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    author: { '@type': 'Person', name: 'Abhishek Mishra', jobTitle: 'Software Development Engineer', worksFor: { '@type': 'Organization', name: 'Oqu AI' }, url: 'https://bingemind.com/abhishek-mishra/' },
    publisher: { '@type': 'Organization', name: 'Bingemind', url: 'https://bingemind.com/' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-5 sm:pt-12">
    <p class="mb-3 hidden sm:inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-brand-ink">{site.tagline}</p>
    <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.08] tracking-tight [text-wrap:balance] sm:text-5xl">
      Knitting increase evenly calculator
    </h1>
    <h2 class="mt-2 max-w-3xl text-lg font-semibold text-muted sm:text-xl">Knitting and crochet: increase or decrease evenly across a row</h2>
    <p class="mt-3 hidden max-w-2xl text-base text-muted sm:block sm:text-lg">{site.description}</p>
    <div class="mt-6 min-h-[44rem] lg:min-h-[32rem]"><Tool auto /></div>
    <AdSlot />
  </section>
  <Article />
  <section aria-labelledby="more-h" class="noprint mx-auto max-w-5xl px-4 pt-16">
    <h2 id="more-h" class="text-2xl font-bold tracking-tight">Calculators for common cases</h2>
    <p class="mt-2 max-w-2xl text-muted">Each page opens the calculator with the case filled in, and explains it.</p>
    <ul class="mt-4 grid gap-x-8 gap-y-1 sm:grid-cols-2">
      {cases.map((c) => <li><a href={href(`/${c.slug}/`)} class="inline-block py-1.5 font-medium text-brand-ink underline underline-offset-4">{c.link}</a></li>)}
    </ul>
  </section>
  <Faq />
</Base>
