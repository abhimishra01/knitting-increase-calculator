---
// The calculator. Results update as you type. Logic lives in src/lib/spread.js (tested).
---
<section id="tool" aria-label="Knitting increase calculator" class="kic rounded-2xl border border-line bg-card p-4 sm:p-6 sm:shadow-[6px_6px_0_0_var(--line)]">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-8">
    <!-- Inputs -->
    <div class="space-y-5">
      <fieldset>
        <legend class="mb-2 text-sm font-semibold">What do you want to do?</legend>
        <div class="seg" role="radiogroup">
          <label><input type="radio" name="mode" value="inc" checked /><span>Increase</span></label>
          <label><input type="radio" name="mode" value="dec" /><span>Decrease</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-2 text-sm font-semibold">Knitting flat or in the round?</legend>
        <div class="seg" role="radiogroup">
          <label><input type="radio" name="shape" value="flat" checked /><span>Flat rows</span></label>
          <label><input type="radio" name="shape" value="round" /><span>In the round</span></label>
        </div>
      </fieldset>

      <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="n" class="text-sm font-semibold">Stitches now</label>
        <div class="stepper mt-2">
          <button type="button" data-step="n" data-dir="-1" aria-label="One fewer stitch on the needle">&minus;</button>
          <input id="n" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" enterkeyhint="done" value="50" maxlength="4" />
          <button type="button" data-step="n" data-dir="1" aria-label="One more stitch on the needle">+</button>
        </div>
      </div>

      <div>
        <label for="k" class="text-sm font-semibold"><span id="k-label">Stitches to add</span></label>
        <div class="stepper mt-2">
          <button type="button" data-step="k" data-dir="-1" aria-label="One fewer change">&minus;</button>
          <input id="k" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" enterkeyhint="done" value="7" maxlength="4" aria-describedby="k-hint" />
          <button type="button" data-step="k" data-dir="1" aria-label="One more change">+</button>
        </div>
        <p id="k-hint" class="mt-1.5 min-h-[1.25rem] text-xs text-muted"></p>
      </div>
      </div>

    </div>

    <!-- Results -->
    <div class="min-w-0">
      <p id="summary" class="min-h-[1.5rem] text-sm font-medium text-muted"></p>
      <div class="mt-2 rounded-xl border border-line bg-paper p-4">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Pattern line</h2>
          <button id="copy" type="button" class="btn">Copy</button>
        </div>
        <p id="result" class="result mt-3 font-mono text-lg font-semibold leading-snug sm:text-xl" aria-live="polite" aria-atomic="true"></p>
        <p id="error" class="mt-1 text-base font-medium text-[color:var(--err)]" role="alert"></p>
      </div>

      <div class="mt-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Your row</h2>
        <div id="dots" class="dots mt-2" role="img" aria-label=""></div>
        <ul class="legend mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted" aria-hidden="true">
          <li><i class="dot"></i> stitch</li>
          <li id="legend-op"><i class="dot new"></i> <span>new stitch</span></li>
        </ul>
      </div>

      <div class="mt-4 min-h-[3.5rem]">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted" id="where-h">Where the changes go</h2>
        <p id="where" class="mt-1 text-sm leading-relaxed"></p>
        <ul id="notes" class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted"></ul>
      </div>
      <details class="opts mt-4 rounded-xl border border-line px-3 py-2">
        <summary class="cursor-pointer text-sm font-semibold">Stitch names and style</summary>
        <div class="mt-3 grid gap-3 pb-1">
          <label class="opt">Row stitch
            <select id="knit"><option value="K">Knit (K)</option><option value="P">Purl (P)</option></select>
          </label>
          <label class="opt">Increase
            <select id="inc">
              <option value="M1">M1 (make one)</option>
              <option value="M1L">M1L (left lean)</option>
              <option value="M1R">M1R (right lean)</option>
              <option value="YO">YO (yarn over)</option>
              <option value="inc1">Inc 1</option>
            </select>
          </label>
          <label class="opt">Decrease
            <select id="dec">
              <option value="auto">K2tog (P2tog on purl)</option>
              <option value="SSK">SSK</option>
              <option value="SKP">SKP</option>
              <option value="K2tog tbl">K2tog tbl</option>
            </select>
          </label>
          <label class="opt">Spacing
            <select id="spacing">
              <option value="even">Most even (every gap fitted)</option>
              <option value="simple">Fewest steps (shorter line)</option>
            </select>
          </label>
          <label class="opt">Repeats
            <select id="style">
              <option value="star">*...; rep from * 7 more times</option>
              <option value="paren">(...) 8 times</option>
            </select>
          </label>
        </div>
      </details>
      <p id="copy-status" class="sr-only" aria-live="polite"></p>
    </div>
  </div>
</section>

<style is:global>
  .kic { --err: #b42318; --dot: color-mix(in oklab, var(--ink) 22%, var(--paper)); }
  :root[data-theme="dark"] .kic { --err: #ff8a80; }
  .kic .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; border-radius: 14px; background: var(--brand-soft); }
  .kic .seg label { position: relative; display: block; }
  .kic .seg input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
  .kic .seg span { display: flex; min-height: 44px; align-items: center; justify-content: center; border-radius: 10px; padding: 0 8px; text-align: center; font-size: 0.9375rem; font-weight: 600; color: var(--muted); transition: background .15s, color .15s; }
  .kic .seg input:checked + span { background: var(--brand); color: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .18); }
  .kic .seg input:focus-visible + span { outline: 2px solid var(--brand-ink); outline-offset: 2px; }
  :root[data-theme="dark"] .kic .seg input:checked + span { background: color-mix(in oklab, var(--brand) 78%, white); color: #16161a; }
  .kic .stepper { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; gap: 4px; }
  .kic .stepper button { min-height: 52px; padding: 0; border-radius: 12px; border: 1px solid var(--line); background: var(--paper); font-size: 1.5rem; font-weight: 600; line-height: 1; color: var(--ink); cursor: pointer; touch-action: manipulation; }
  .kic .stepper button:hover { border-color: var(--brand); }
  .kic .stepper button:active { background: var(--brand-soft); }
  .kic .stepper input { min-height: 52px; width: 100%; border-radius: 12px; border: 1px solid var(--line); background: var(--paper); text-align: center; font-family: var(--font-mono); font-size: 1.375rem; font-weight: 700; padding: 0; color: var(--ink); font-variant-numeric: tabular-nums; }
  .kic .stepper input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand) 30%, transparent); }
  .kic .stepper input[aria-invalid="true"] { border-color: var(--err); }
  .kic .btn { min-height: 44px; padding: 0 18px; border-radius: 999px; background: var(--brand); color: #fff; font-weight: 700; font-size: 0.9375rem; cursor: pointer; border: 0; touch-action: manipulation; }
  .kic .btn:hover { filter: brightness(1.08); }
  .kic .btn:disabled { opacity: .45; cursor: not-allowed; }
  :root[data-theme="dark"] .kic .btn { background: color-mix(in oklab, var(--brand) 78%, white); color: #16161a; }
  .kic .opt { display: grid; gap: 4px; font-size: 0.8125rem; font-weight: 600; color: var(--muted); }
  .kic .opt select { min-height: 44px; border-radius: 10px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); padding: 0 10px; font-size: 1rem; font-weight: 500; }
  .kic .result { min-height: 5.25rem; overflow-wrap: anywhere; color: var(--ink); }
  .kic .result b { color: var(--brand-ink); font-weight: 800; }
  .kic .dots { display: flex; flex-wrap: wrap; gap: 5px 4px; align-content: flex-start; min-height: 5.5rem; max-height: 15rem; overflow: auto; padding: 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--paper); }
  .kic .dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: var(--dot); flex: none; }
  .kic .dot.new { border-radius: 2px; transform: rotate(45deg) scale(.85); background: var(--brand); }
  :root[data-theme="dark"] .kic .dot.new { background: color-mix(in oklab, var(--brand) 70%, white); }
  .kic .dot.new.pill { border-radius: 99px; width: 22px; transform: none; }
  .kic .dots .gap { margin-right: 8px; }
  .kic .legend .dot { vertical-align: -2px; margin-right: 2px; }
</style>

<script>
  import { plan, summary, MAX_STITCHES } from '../lib/spread.js';

  const $ = (id: string) => document.getElementById(id)!;
  const nEl = $('n') as HTMLInputElement;
  const kEl = $('k') as HTMLInputElement;
  const q = (name: string) => (document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement).value;
  const sel = (id: string) => ($(id) as HTMLSelectElement).value;

  // Start from the address bar if it carries a shared setup.
  try {
    const u = new URLSearchParams(location.search);
    const set = (el: HTMLInputElement, v: string | null) => { if (v && /^\d{1,4}$/.test(v)) el.value = v; };
    set(nEl, u.get('n')); set(kEl, u.get('k'));
    for (const name of ['mode', 'shape']) {
      const v = u.get(name === 'mode' ? 'm' : 's');
      const r = document.querySelector(`input[name="${name}"][value="${v}"]`) as HTMLInputElement | null;
      if (r) r.checked = true;
    }
  } catch {}

  const num = (el: HTMLInputElement) => (el.value.trim() === '' ? NaN : Number(el.value));
  let lastText = '';

  function esc(s: string) { return s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!)); }
  // Bold the change stitch in the pattern line so it stands out.
  function mark(text: string, op: string) {
    const safe = esc(text);
    const o = esc(op).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return safe.replace(new RegExp(`(?<![A-Za-z0-9])${o}(?![A-Za-z0-9])`, 'g'), '<b>$&</b>');
  }

  function render() {
    const mode = q('mode');
    const shape = q('shape');
    const isDec = mode === 'dec';
    $('k-label').textContent = isDec ? 'Stitches to remove' : 'Stitches to add';
    $('legend-op').innerHTML = isDec
      ? '<i class="dot new pill"></i> <span>2 stitches worked together</span>'
      : '<i class="dot new"></i> <span>new stitch</span>';

    const knit = sel('knit');
    const incSel = sel('inc');
    const decSel = sel('dec');
    const n = num(nEl);
    const k = num(kEl);
    nEl.setAttribute('aria-invalid', String(!(Number.isInteger(n) && n >= 1)));
    $('k-hint').textContent = isDec && Number.isInteger(n) && n >= 2 ? `Most you can decrease: ${Math.floor(n / 2)}.` : '';

    const p = plan({
      stitches: n, changes: k, mode, shape, knit, style: sel('style'), spacing: sel('spacing'),
      inc: incSel === 'inc1' ? 'Inc 1' : incSel,
      dec: decSel === 'auto' ? (knit === 'P' ? 'P2tog' : 'K2tog') : decSel === 'K2tog tbl' ? (knit === 'P' ? 'P2tog tbl' : 'K2tog tbl') : decSel,
    });

    const result = $('result'), err = $('error'), dots = $('dots'), where = $('where'), notes = $('notes'), sum = $('summary');
    const copy = $('copy') as HTMLButtonElement;
    kEl.setAttribute('aria-invalid', String(!p.ok && Number.isFinite(n) && Number.isFinite(k)));

    if (!p.ok) {
      const blank = !Number.isFinite(n) || !Number.isFinite(k);
      result.innerHTML = '';
      err.textContent = blank ? '' : p.error;
      if (blank) result.textContent = 'Enter both numbers to see your pattern line.';
      sum.textContent = '';
      dots.innerHTML = ''; dots.setAttribute('aria-label', '');
      where.textContent = ''; notes.innerHTML = '';
      copy.disabled = true; lastText = '';
      return;
    }

    err.textContent = '';
    result.innerHTML = mark(p.text + '.', p.op);
    lastText = p.text + '.';
    copy.disabled = false;
    sum.textContent = summary(p) + (shape === 'round' ? ' Work it around the whole round.' : '');

    // Dots: one span per stitch. Build in one pass.
    let html = '';
    let count = 0;
    for (const c of p.cells) {
      const g = count > 0 && count % 10 === 0 ? ' gap' : '';
      if (c === 'k') { html += `<i class="dot${g}"></i>`; count++; }
      else if (c === 'i') { html += `<i class="dot new"></i>`; }
      else { html += `<i class="dot new pill${g}"></i>`; count += 2; }
    }
    dots.innerHTML = html;
    dots.setAttribute('aria-label', `Picture of your row. ${p.cells.filter((c) => c !== 'k').length} ${isDec ? 'decreases' : 'increases'} spread across ${p.n} stitches.`);

    const lim = 40;
    const list = p.after.slice(0, lim).join(', ') + (p.after.length > lim ? ', ...' : '');
    $('where-h').textContent = 'Where the changes go';
    where.textContent = isDec
      ? `Work ${p.op} over these stitch pairs, counting from the first stitch you have now: starting at stitch ${list}.`
      : `${p.op} after stitch ${list} (counted on the ${p.n} stitches you have now${p.after[0] === 0 ? '; 0 means before the first stitch' : ''}).`;
    notes.innerHTML = p.notes.map((t: string) => `<li>${esc(t)}</li>`).join('');

    try {
      const u = new URLSearchParams({ n: String(n), k: String(k), m: mode, s: shape });
      history.replaceState(null, '', `${location.pathname}?${u}`);
    } catch {}
  }

  // Keep only digits. Arrow keys step the value.
  for (const el of [nEl, kEl]) {
    el.addEventListener('input', () => {
      const d = el.value.replace(/\D/g, '').slice(0, 4);
      if (d !== el.value) el.value = d;
      render();
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') { e.preventDefault(); step(el, e.key === 'ArrowUp' ? 1 : -1); }
    });
    el.addEventListener('focus', () => el.select());
  }
  function step(el: HTMLInputElement, dir: number) {
    const cur = Number.isFinite(num(el)) ? num(el) : 0;
    const min = el === nEl ? 1 : 0;
    el.value = String(Math.min(MAX_STITCHES, Math.max(min, cur + dir)));
    render();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => {
    b.addEventListener('click', () => step(b.dataset.step === 'n' ? nEl : kEl, Number(b.dataset.dir)));
  });
  document.querySelectorAll('input[type=radio], select').forEach((el) => el.addEventListener('change', render));

  $('copy').addEventListener('click', async () => {
    if (!lastText) return;
    const btn = $('copy');
    let ok = false;
    try { await navigator.clipboard.writeText(lastText); ok = true; } catch {
      const t = document.createElement('textarea'); t.value = lastText; document.body.appendChild(t); t.select();
      try { ok = document.execCommand('copy'); } catch {} t.remove();
    }
    btn.textContent = ok ? 'Copied' : 'Press Ctrl+C';
    $('copy-status').textContent = ok ? 'Pattern line copied.' : 'Copy failed. Select the text and copy it.';
    setTimeout(() => { btn.textContent = 'Copy'; }, 1800);
  });

  render();
</script>
